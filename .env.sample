# ============================================================================
# SwasthyaAI Python Backend — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.sample .env
# ============================================================================

# ─── LLM Provider ──────────────────────────────────────────────────────────
# Which LLM to use by default: "openai" or "gemini"
DEFAULT_LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4.1

# Google Gemini (alternative)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Live-call (voice) models — smaller/faster than the report models above
VOICE_OPENAI_MODEL=gpt-4.1-mini
VOICE_GEMINI_MODEL=gemini-2.5-flash-lite
VOICE_MAX_TOKENS=150
VOICE_TEMPERATURE=0.3

# Post-call clinical report: fast (default, parallel steps) or supervisor (agentic, slower)
CLINICAL_MODE=fast

# ─── Search ────────────────────────────────────────────────────────────────
SERPAPI_KEY=your-serpapi-key-here

# ─── Embeddings & RAG ─────────────────────────────────────────────────────
# OpenAI embedding model for RAG (needs OPENAI_API_KEY); empty = text-embedding-3-small.
# Changing it requires re-uploading RAG documents.
EMBEDDING_MODEL=
LANCEDB_PATH=./lancedb_store

# ─── Server ────────────────────────────────────────────────────────────────
HOST=localhost
PORT=8000
# Optional. Leave empty (or point at this server) and call reports are processed in-process.
# Set it only to forward call-end payloads to an external service.
WEBHOOK_URL=
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Supabase (Required for dashboard & voice call storage) ───────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-jwt-here

# ─── Sarvam AI (Voice TTS/STT) ────────────────────────────────────────────
SARVAM_API_KEY=your-sarvam-api-key-here
# bulbul:v3 speaker: priya, ritu, neha, kavya, shubh, aditya, … (bulbul:v2 names like anushka are retired)
SARVAM_VOICE_ID=priya
# bulbul:v3 (default, 11 languages) or bulbul:v4-flash (lower latency; no Malayalam/Odia, which
# fall back to v3 automatically). v4-flash needs one of its own speaker names in SARVAM_VOICE_ID.
SARVAM_TTS_MODEL=bulbul:v3

# ─── Exotel (Telephony — optional) ────────────────────────────────────────
EXOTEL_SID=your-exotel-account-sid
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_BASE=https://api.exotel.com/v1

# ─── Vobiz (Telephony — optional) ─────────────────────────────────────────
VOBIZ_AUTH_ID=your-vobiz-auth-id
VOBIZ_AUTH_TOKEN=your-vobiz-auth-token
VOBIZ_PHONE_NUMBER=+91XXXXXXXXXX

# ─── Telnyx (Telephony — optional) ────────────────────────────────────────
TELNYX_API_KEY=your-telnyx-api-key-here
TELNYX_TEXML_APP_ID=your-texml-app-id
TELNYX_SUB_ACCOUNT_ID=your-sub-account-uuid
TELNYX_BUSINESS_NAME=your-business-name
TELNYX_PHONE_NUMBER=+1XXXXXXXXXX
TELNYX_PUBLIC_HOST=your-ngrok-subdomain.ngrok-free.app

# ─── VoiceLink (India DIDs — optional) ────────────────────────────────────
# Platform reseller login from app.voicelink.co.in; purchases debit this account's wallet.
VOICELINK_USERNAME=your-voicelink-username
VOICELINK_PASSWORD=your-voicelink-password

# ─── Deepgram (STT — optional) ────────────────────────────────────────────
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# ─── Bolna (second call engine — optional) ────────────────────────────────
# API key: Bolna dashboard → Developers → API Keys. Agent: build it in the Bolna dashboard
# (Sarvam transcriber + voice, a fast LLM, prompt = inbound_prompt.md) and set its webhook URL to
# https://<your-ngrok-host>/bolna/webhook. Without a public URL use POST /bolna/executions/{id}/sync.
BOLNA_API_KEY=your-bolna-api-key
BOLNA_AGENT_ID=your-bolna-agent-uuid
# Optional: one of your Bolna numbers (else Bolna's default caller ID is used)
BOLNA_FROM_NUMBER=
